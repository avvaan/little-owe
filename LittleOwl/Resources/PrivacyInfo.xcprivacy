<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Little Owl collects nothing. There is no networking code in the app, no
	  analytics, no crash reporting and no third-party SDKs, so every list below is
	  empty and must stay that way.

	  The microphone is used only while the child is talking to the owl. The recording
	  is held in one in-memory buffer and released when playback ends; it is never
	  written to disk and never leaves the device. That is not "collection" under
	  Apple's definition, which is why NSPrivacyCollectedDataTypes is empty.
	-->
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!--
	  Required-reason APIs. One, and Apple rejects a build that uses one of these
	  without declaring it.

	  UserDefaults is read and written by ParentSettings, and by nothing else in the
	  app. CA92.1 is the reason for "information accessible only to the app itself" —
	  which is the literal truth here: four keys, no app group, no shared container,
	  nothing read by anyone else and nothing about the child.

	  Anything added to this list needs the code to justify it. As of this build the
	  app touches no file timestamps, no disk-space APIs, no system boot time and no
	  active-keyboard API, so those four categories are absent rather than empty.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
